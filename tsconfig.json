{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        // A signer spec drives the e2e agent's nonce-cap bypass, whose types import the package by name: here, its sources.
        "paths": { "@peersyst/fiber-lsp-sdk": ["./src"] }
    },
    "include": ["src", "test"]
}
