#!/usr/bin/env bash
# Linked at <fiber-checkout>/target/debug/fiber-lsp-sdk-agent by install.sh.
set -euo pipefail

self="$(readlink -f "$0")"
main="$(dirname "$self")/../dist/src/main.js"

if [[ ! -f "$main" ]]; then
    echo "fiber-lsp-sdk-agent: $main is missing, build the agent first: pnpm --dir e2e/agent build" >&2
    exit 1
fi

# The suites run past fiber's third session on a slot only with the bypass (docs/e2e-agent.md).
exec node "$main" --nonce-cap-bypass "$@"
